#**
 * Render twitter snippet
 *
 *#
#set($width = "400px")##
#set($height = "500px")##
#set($theme = "light")##
#set($chrome = "")##
#set($notrack = "true")
#if(${snippet.attrs['nofooter']})
     #set($chrome = "$chrome nofooter")##
#end
#if(${snippet.attrs['noheader']})
     #set($chrome = "$chrome noheader")##
#end
#if(${snippet.attrs['noborders']})
     #set($chrome = "$chrome noborders")##
#end
#if(${snippet.attrs['noscrollbar']})
     #set($chrome = "$chrome noscrollbar")##
#end
#if(${snippet.attrs['transparent']})
     #set($chrome = "$chrome transparent")##
#end
#if(${snippet.attrs['theme']})
     #set($theme = ${snippet.attrs['theme']})##
#end
#if(${snippet.attrs['width']})
     #set($width = ${snippet.attrs['width']})##
#end
#if(${snippet.attrs['height']})
     #set($height = ${snippet.attrs['height']})##
#end
#if(${snippet.attrs['not-track']})
     #set($notrack = ${snippet.attrs['not-track']})##
#end
<a class="twitter-timeline"
    #if(${chrome} && ${chrome} != "")data-chrome="${chrome}"#end
    #addAttr( 'data-link-color' ${snippet.attrs['link-color']} )
    #addAttr( 'data-border-color' ${snippet.attrs['border-color']} )
    #addAttr( 'data-lang' ${snippet.attrs['lang']} )
    #addAttr( 'data-aria-polite' ${snippet.attrs['aria-polite']} )
    #addAttr( 'data-aria-relevant' ${snippet.attrs['aria-relevant']} )
    #addAttr( 'data-aria-live' ${snippet.attrs['aria-live']} )
    #addAttr( 'data-aria-atomic' ${snippet.attrs['aria-atomic']} )
    #addAttr( 'data-aria-busy' ${snippet.attrs['aria-busy']} )
    #addAttr( 'data-aria-controls' ${snippet.attrs['aria-controls']} )
    #addAttr( 'data-aria-describedby' ${snippet.attrs['aria-describedby']} )
    #addAttr( 'data-aria-disabled' ${snippet.attrs['aria-disabled']} )
    #addAttr( 'data-aria-hidden' ${snippet.attrs['aria-hidden']} )
    #addAttr( 'data-aria-labelledby' ${snippet.attrs['aria-labelledby']} )
    #addAttr( 'data-aria-live' ${snippet.attrs['aria-live']} )
    #addAttr( 'data-width' ${width} )
    #addAttr( 'data-height' ${height} )
    #addAttr( 'data-dnt' ${notrack} )
    #addAttr( 'data-theme' ${theme} )
    #addAttr( 'data-tweet-limit' ${snippet.attrs['tweet-limit']} )
    href="https://twitter.com/${snippet.attrs['feed']}?ref_src=twsrc%5Etfw">$!{snippet.text}</a>
<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
