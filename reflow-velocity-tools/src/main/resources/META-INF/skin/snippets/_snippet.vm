#**
 * display information of snippet
 *#
#macro( debug $snippet $isRoot $indent )##
#*  *##if ( !$snippet )##
#*      *##break##
#* *##end##
#*  *##if( $isRoot )##
#*      *##set( $indent = 0 )##
<pre><code class="placeholder-debug text-left language-yaml">
#*  *##end##
#*  *##set( $sp = $display.space( $indent ) )##
##
${sp}#if( $indent > 0 )- #{end}name: ${snippet.name}
##
#*  *##if( $indent > 0 )##
#*      *##set( $indent2 = $indent + 2 )##
#*      *##set( $sp = $display.space( $indent2 ) )##
#*  *##end##
#*  *##if( ${snippet.type} )
${sp}type: ${snippet.type}
#*  *##end##
##
#*  *##set( $html = "" )##
#*  *##if( $snippet.ownHtml )##
#*      *##set( $html = $esc.html( $htmlTool.normaliseWhitespace( $snippet.ownHtml ) ) )##
#*  *##end##
#*  *##set( $attrs = "" )##
#*  *##if( $snippet.attrs )##
#*      *##set( $attrs = $esc.html( $htmlTool.normaliseWhitespace( $snippet.attrs.toString() ) ) )##
#*  *##end##
${sp}attributes: ${attrs}
${sp}isHtmlTag: ${snippet.isHtmlTag()}
${sp}ownHtml: '${html}'
${sp}parent: $!snippet.parent.name
##
#*  *##if( !${snippet.children.isEmpty()} )##
##
${sp}children:
##
#*      *##set( $indent = $indent + 4 )##
#*      *##foreach( $child in ${snippet.children} )##
#*          *##debug( $child false $indent )##
#*      *##end##
#*      *##set( $indent = $indent - 4 )##
#*      *##set( $sp = $display.space($indent) )##
#*  *##end##
#*  *##if( $isRoot )##
</code></pre>
#*  *##end##
#end##
