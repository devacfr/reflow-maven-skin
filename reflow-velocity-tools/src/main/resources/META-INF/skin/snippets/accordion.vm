#* Render accordion snippet * Usage: *
  {{% accordion id="myAccordion" %}}
    <item title="Accordion Item #1">
      Accordion item #1 content
    </item>
    <item title="Accordion Item #2">
      Accordion item #2 content
    </item>
  {{% /accordion %}}
*#
#macro( render_accordion_item $index $item )##
#*  *##set( $headingId = ${parentId} + "_heading_" + ${index} )##
#*  *##set( $collapseId = ${parentId} + "_collapse_" + ${index} )##
#*  *##set( $showClass = "collapse" )##
#*  *##set( $show = $index == 1 )##
#*  *##if( $show )##
#*    *##set( $showClass = "collapse show" )##
#*  *##end##
<div class="card">
    <div class="card-header" id="$headingId">
        <h2 class="no-anchor mt-0 mb-0">
            <button
                class="btn btn-link btn-block text-left"
                type="button"
                data-toggle="collapse"
                data-target="#${collapseId}"
                aria-expanded="$show"
                aria-controls="${collapseId}">
                ${item.title}
            </button>
        </h2>
    </div>
    <div id="${collapseId}" class="${showClass}" aria-labelledby="${headingId}" data-parent="#${parentId}">
        <div class="card-body">
          #evaluate( ${item.html} )
        </div>
    </div>
</div>
#end##
## Main accordion rendering
#*  *##set( $class = "accordion")##
#*  *##set( $parentId = $snippet.id )##
<div #addhtmlattributes( ${snippet} ${class} )="#addHtmlAttributes( ${snippet} ${class} )">
#*  *##set( $index = 1)##
#*  *##foreach($item in $snippet.items)##
#*    *##render_accordion_item( $index $item )##
#*    *##set( $index = $index + 1)##
#*  *##end##
</div>
