#* Render accordion snippet * Usage: *
  {{% accordion id="myAccordion" %}}
    <accordion-item title="Accordion Item #1">
      Accordion item #1 content
    </accordion-item>
    <accordion-item title="Accordion Item #2">
      Accordion item #2 content
    </accordion-item>
  {{% /accordion %}}
*#
#macro( render_accordion_item $index $item )##
#*  *##set( $headingId = ${parentId} + "_heading_" + ${index} )##
#*  *##set( $collapseId = ${parentId} + "_collapse_" + ${index} )##
#*  *##set( $showClass = "accordion-collapse collapse" )##
#*  *##set( $show = $index == 1 )##
#*  *##if( $show )##
#*    *##set( $showClass = "$showClass show" )##
#*  *##end##
<div class="accordion-item">
    <h2 class="accordion-header no-anchor">
#*    *##set($btnClass = "accordion-button")##
#*    *##if( !$show )##
#*      *##set($btnClass = "$btnClass collapsed")##
#*    *##end##
      <button class="${btnClass}" type="button" data-bs-toggle="collapse" data-bs-target="#${collapseId}" aria-expanded="$show" aria-controls="${collapseId}">
        ${item.title}
      </button>
    </h2>
#*  *##if( $snippet.alwaysOpen || $snippet.alwaysOpen == "true" )##
    <div id="${collapseId}" class="${showClass}">
      <div class="accordion-body">
        #evaluate( ${item.html} )
      </div>
    </div>
#*  *##else##
    <div id="${collapseId}" class="${showClass}" data-bs-parent="#${parentId}">
      <div class="accordion-body">
        #evaluate( ${item.html} )
      </div>
    </div>
#*  *##end##
</div>
#end##
## Main accordion rendering
#*  *##set( $class = "accordion")##
#*  *##set( $parentId = $snippet.id )##
#*  *##if( $snippet.flush || $snippet.flush == "true" )##
#*    *##set( $class = "$class accordion-flush")##
#*  *##end##
<div #addHtmlAttributes( ${snippet} ${class} )>
#*  *##set( $index = 1)##
#*  *##foreach($item in $snippet["accordion-item"])##
#*    *##render_accordion_item( $index $item )##
#*    *##set( $index = $index + 1)##
#*  *##end##
</div>
