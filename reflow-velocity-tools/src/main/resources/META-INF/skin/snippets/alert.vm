#**
 * Render alert snippet
 * Usage:
 * {{< alert color="" title="" level="" dismissable />}}
 *#
#*  *##set( $class = "alert")
#*  *##if( ${snippet.attrs['color']})
#*      *##set( $class = "$class alert-${snippet.attrs['color']}")
#*  *##end##
#*  *##if( ${snippet.attrs['dismissable']})
#*      *##set( $class = "$class alert-dismissable show fade")
#*  *##end##
#*  *##if( ${snippet.attrs['class']})
#*      *##set( $class = "$class ${snippet.attrs['class']}")
#*  *##end##
<div #if( ${snippet.attrs['id']} )id="${snippet.attrs['id']}" #end class="$class" role="alert">
#*  *##if( ${snippet.attrs['title']})
#*      *##set( $level = 5)
#*      *##if( ${snippet.attrs['level']})
#*          *##set( $level = ${snippet.attrs['level']})
#*      *##end##
    <h${level} class="alert-heading no-anchor">
         ${snippet.attrs['title']}
    </h${level}>
#*  *##end##
    #render_html( ${snippet} )
#*  *##if( ${snippet.attrs['dismissable']})
    <button type="button" class="close" data-bs-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
#*  *##end##
</div>
