#**
 * Render NavSideMenu web element page
 *
 *###
#macro( renderNavSideMenu )##
#*  *##set($navside = $pageContext.navSideMenu)##
<div class="navside-wrapper col-lg-2">
    <div class="navside-menu navside-expand-lg d-print-none ms-lg-1 border-right $navside.cssClass" #addAttrIf($navside.theme, "data-bs-theme", $navside.theme)>
        <div class="navside-brand">${navside.name}</div>
        <button class="navside-toggler border" type="button" data-bs-toggle="collapse" data-bs-target="#menu-list" aria-controls="menu-list" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navside-toggler-icon"></span>
        </button>
#*  *##if( $navside.hasItems )##
        <div id="menu-list" class="flex-column collapse navside-collapse">
            <ul id="menu-content" class="menu-content navside-nav">
#*      *##set ( $counterMenu = 1)##
#*      *##foreach ( $item in $navside.items )##
#*          *##set ( $itemId = "m-navside-menu_"+ $counterMenu)##
                <li class="navside-item #if($item.hasItems)collapsable collapsed#end" #if( $item.hasItems ) data-bs-toggle="collapse" data-bs-target="#${itemId}" aria-controls="${itemId}" aria-expanded="false"#end>
                  <a class="navside-link" #if( !$item.hasItems ) href="#${item.href}" slug-name="${item.slugName}" #{else}href="#"#{end}>
#*          *##if ( ${item.icon} )<i class="${item.icon}" aria-hidden="true"></i>#end##
                    $item.name
#*          *##if( $item.hasItems)##
                        <span class="arrow"></span>
#*          *##end##
                  </a>
                </li>
#*          *##if( $item.hasItems)##
                <ul class="sub-menu navside-nav collapse" id="$itemId">
#*              *##foreach ( $subItem in $item.items )##
                    <li class="navside-item"><a class="navside-link" href="#${subItem.href}" slug-name="${subItem.slugName}">${subItem.name}</a></li>
#*              *##end##
                </ul>
#*          *##end##
#*          *##set ( $counterMenu = $counterMenu + 1)##
#*      *##end##
            </ul>
        </div>
#*  *##end##
    </div>
</div>
#end##
#renderNavSideMenu()
